PORT=3000

# Google AI Studio (Gemini) OpenAI-compatible endpoint. Keep the key on the server.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# Optional Gmail API OAuth credentials. Create these in Google Cloud Console,
# enable Gmail API, and add this app's callback URL to authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Streamlit app uses Gmail SMTP with an App Password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: OAuth settings used only by the existing Express web app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
